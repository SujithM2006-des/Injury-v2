# Address of the AthleteGuard backend (FastAPI). Leave empty to use http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# "Sign in with Google" (Firebase Authentication)
# Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
# (these values are public by design; access is controlled by the backend's Gmail -> role list)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# The backend needs the same project id in src/.env:  FIREBASE_PROJECT_ID=your-project
# Web client ID (Firebase -> Authentication -> Sign-in method -> Google -> Web SDK configuration).
# Set it to open Google's own sign-in window (accounts.google.com) instead of <project>.firebaseapp.com,
# which some networks block. Also add http://localhost:5173 to its "Authorized JavaScript origins"
# in Google Cloud console -> APIs & Services -> Credentials.
VITE_GOOGLE_CLIENT_ID=
